# ========================================
# 阿里云百炼 MultiModalDialog 配置
# ========================================

# [必填] 百炼 API Key - 在 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [必填] 百炼业务空间 ID - 在百炼控制台 -> 业务空间 中获取
WORKSPACE_ID=llm-xxxxxxxxxxxxxxxx

# [必填] 多模态交互应用 ID - 在百炼控制台 -> 应用 -> 创建"多模态交互"应用后获取
APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] TTS 音色，默认 longxiaochun_v2
# 可选: longxiaochun_v2, longxiaoxia_v2, longshuo_v2, longjing_v2 等
# 具体音色取决于你在百炼控制台多模态应用中选择的 TTS 模型
# VOICE=longxiaochun_v2

# [可选] 下行音频采样率，默认 24000
# 千问-TTS/千问3-TTS 仅支持 24000
# DOWNSTREAM_SAMPLE_RATE=24000

# ===== 配置说明 =====
# APP_ID 是你在百炼控制台创建的「多模态交互应用」的ID
# 例如你的 UUMO 应用: 百炼控制台 -> 多模态交互开发套件 -> 我的应用
# RAG 知识库需要在应用配置中挂载, 代码无需额外处理, SDK 自动调用
# 应用URL参考: https://bailian.console.aliyun.com -> 多模态交互开发套件 -> 我的应用
